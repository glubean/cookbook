# Demo-only example for local development.
#
# Copy this file to .env.secrets if you want to run recipes that need tokens.
# The real .env.secrets file is gitignored and should never be committed.
#
# This file also demonstrates `${NAME}` expansion:
# map a host environment variable into the project-local secret name used by
# the cookbook.
#
# Example:
#   export GITHUB_TOKEN=ghp_...
#   cp .env.secrets.example .env.secrets
#
# Then the cookbook can read GITHUB_TOKEN from .env.secrets without forcing
# you to rename or duplicate the raw secret value in multiple places.

# GitHub token — required for explore/github/advanced
# Get one at: https://github.com/settings/tokens (scopes: read:user, public_repo)
GITHUB_TOKEN=${GITHUB_TOKEN}

# Stripe — required for explore/stripe
# Use your test mode secret key (never your live key).
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}

# OpenAI — required for explore/ai-contracts
OPENAI_API_KEY=${OPENAI_API_KEY}

# Smee.io tunnel — required for explore/stripe/webhook
# 1. Go to https://smee.io/new
# 2. Copy the channel URL
# 3. Export it locally or paste a literal value into your local .env.secrets
SMEE_URL=${SMEE_URL}
