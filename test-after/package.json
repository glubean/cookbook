{
  "name": "@glubean/cookbook-test-after",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "pnpm run check && pnpm run test:public && pnpm run test:secrets",
    "test:public": "GLUBEAN_MOCK=1 STRIPE_SECRET_KEY=sk_test_dummy_for_mocked_run glubean run --profile public",
    "test:secrets": "glubean run --profile secrets",
    "test:all": "GLUBEAN_MOCK=1 STRIPE_SECRET_KEY=sk_test_dummy_for_mocked_run glubean run --profile all",
    "test:smoke": "glubean run --profile smoke",
    "test:mocking": "GLUBEAN_MOCK=1 STRIPE_SECRET_KEY=sk_test_dummy_for_mocked_run glubean run --profile public --suite mocking",
    "test:dummyjson": "glubean run --profile public --suite dummyjson --pick all"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.53",
    "@glubean/auth": "0.1.9",
    "@glubean/browser": "0.1.13",
    "@glubean/graphql": "0.2.4",
    "@glubean/grpc": "0.2.4",
    "@glubean/runner": "0.3.2",
    "@glubean/sdk": "0.3.2",
    "@grpc/grpc-js": "1.14.3",
    "@grpc/proto-loader": "0.7.15",
    "ai": "6.0.168",
    "eventsource-parser": "3.0.6",
    "smee-client": "5.0.0",
    "ws": "8.20.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "msw": "^2.14.6",
    "typescript": "5.9.3"
  }
}
